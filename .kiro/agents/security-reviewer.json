{
  "name": "security-reviewer",
  "description": "Pre-push security review agent — scans code diffs for vulnerabilities, secrets, and security anti-patterns",
  "model": "claude-opus-4.6",
  "prompt": "file://./prompts/security-reviewer.md",
  "tools": [
    "read",
    "thinking"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "resources": [
    "file://TENETS.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/coding-standards.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env/**",
          "**/.env.*",
          "**/.env.*/**",
          "**/*.env",
          "**/*.env/**",
          "**/*.env.*",
          "**/*.env.*/**",
          "**/*.pem",
          "**/*.pem/**",
          "**/*.key",
          "**/*.key/**",
          "**/*.p12",
          "**/*.p12/**",
          "**/*.pfx",
          "**/*.pfx/**",
          "**/*id_rsa*",
          "**/*id_rsa*/**",
          "**/*id_ed25519*",
          "**/*id_ed25519*/**",
          "**/*credentials*",
          "**/*credentials*/**",
          "**/*.secret*",
          "**/*.secret*/**",
          "**/*.npmrc",
          "**/*.npmrc/**",
          "**/*.netrc",
          "**/*.netrc/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:786a987b403146ef8efdeffd3f671e5e167fedaede12e9c093573f37a757b7ed",
    "source": "sha256:16290434db1f049b49b7c077dffd82d5212796b931939ef9509d0a84fbfa8d35"
  }
}
