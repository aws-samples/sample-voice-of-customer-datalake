{
  "name": "security-reviewer",
  "description": "Pre-push security review agent — scans code diffs for vulnerabilities, secrets, and security anti-patterns",
  "model": "claude-opus-4.6",
  "prompt": "file://./prompts/security-reviewer.md",
  "tools": [
    "read",
    "thinking"
  ],
  "allowedTools": [
    "thinking"
  ],
  "resources": [
    "file://TENETS.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/coding-standards.md"
  ],
  "toolsSettings": {
    "fs_read": {
      "allowedPaths": [
        "./**"
      ],
      "deniedPaths": [
        "**/.env",
        "**/.env.*",
        "**/*.env",
        "**/*.env.*",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx",
        "**/*id_rsa*",
        "**/*id_ed25519*",
        "**/*credentials*",
        "**/*.secret*",
        "**/*.npmrc",
        "**/*.netrc"
      ]
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env/**",
          "**/.env.*",
          "**/.env.*/**",
          "**/*.env",
          "**/*.env/**",
          "**/*.env.*",
          "**/*.env.*/**",
          "**/*.pem",
          "**/*.pem/**",
          "**/*.key",
          "**/*.key/**",
          "**/*.p12",
          "**/*.p12/**",
          "**/*.pfx",
          "**/*.pfx/**",
          "**/*id_rsa*",
          "**/*id_rsa*/**",
          "**/*id_ed25519*",
          "**/*id_ed25519*/**",
          "**/*credentials*",
          "**/*credentials*/**",
          "**/*.secret*",
          "**/*.secret*/**",
          "**/*.npmrc",
          "**/*.npmrc/**",
          "**/*.netrc",
          "**/*.netrc/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  }
}
