{
  "name": "test-generator",
  "description": "Post-task test generation agent — analyzes changes to determine if they're bug fixes or features, then generates targeted tests",
  "model": "claude-opus-4.6",
  "prompt": "file://./prompts/test-generator.md",
  "tools": [
    "read",
    "shell",
    "thinking",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "fs_write",
    "thinking",
    "shell"
  ],
  "resources": [
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/coding-standards.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/testing.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env/**",
          "**/.env.*",
          "**/.env.*/**",
          "**/*.env",
          "**/*.env/**",
          "**/*.env.*",
          "**/*.env.*/**",
          "**/*.pem",
          "**/*.pem/**",
          "**/*.key",
          "**/*.key/**",
          "**/*.p12",
          "**/*.p12/**",
          "**/*.pfx",
          "**/*.pfx/**",
          "**/*id_rsa*",
          "**/*id_rsa*/**",
          "**/*id_ed25519*",
          "**/*id_ed25519*/**",
          "**/*credentials*",
          "**/*credentials*/**",
          "**/*.secret*",
          "**/*.secret*/**",
          "**/*.npmrc",
          "**/*.npmrc/**",
          "**/*.netrc",
          "**/*.netrc/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  }
}
