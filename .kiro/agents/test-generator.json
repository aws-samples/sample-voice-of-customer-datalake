{
  "name": "test-generator",
  "description": "Post-task test generation agent — analyzes changes to determine if they're bug fixes or features, then generates targeted tests",
  "model": "claude-opus-4.6",
  "prompt": "file://./prompts/test-generator.md",
  "tools": [
    "read",
    "shell",
    "thinking",
    "write"
  ],
  "allowedTools": [
    "thinking"
  ],
  "resources": [
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/coding-standards.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/testing.md"
  ],
  "toolsSettings": {
    "fs_read": {
      "allowedPaths": [
        "./**"
      ],
      "deniedPaths": [
        "**/.env",
        "**/.env.*",
        "**/*.env",
        "**/*.env.*",
        "**/*.envrc",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx",
        "**/*.ppk",
        "**/*.jks",
        "**/*id_rsa*",
        "**/*id_ed25519*",
        "**/*id_ecdsa*",
        "**/*id_dsa*",
        "**/*credentials*",
        "**/*.secret*",
        "**/*.npmrc",
        "**/*.netrc",
        "**/*.pypirc",
        "**/*.pgpass",
        "**/*.tfvars"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "./**"
      ],
      "deniedPaths": [
        "**/.env",
        "**/.env.*",
        "**/*.env",
        "**/*.env.*",
        "**/*.envrc",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx",
        "**/*.ppk",
        "**/*.jks",
        "**/*id_rsa*",
        "**/*id_ed25519*",
        "**/*id_ecdsa*",
        "**/*id_dsa*",
        "**/*credentials*",
        "**/*.secret*",
        "**/*.npmrc",
        "**/*.netrc",
        "**/*.pypirc",
        "**/*.pgpass",
        "**/*.tfvars"
      ]
    },
    "shell": {
      "allowedCommands": [
        "cd (\\./)?(voc-datalake|voc-datalake/frontend|voc-datalake/lambda/stream)/?",
        "npx vitest (run|--run)( [^;&|<>$`\\\\(){}~!\\n\\r]*)?",
        "(python|python3|\\.venv/bin/python|voc-datalake/\\.venv/bin/python) -m pytest( [^;&|<>$`\\\\(){}~!\\n\\r]*)?",
        "node --test( [^;&|<>$`\\\\(){}~!\\n\\r]*)?",
        "npm (test|run test[A-Za-z0-9:_-]*)( [^;&|<>$`\\\\(){}~!\\n\\r]*)?"
      ],
      "deniedCommands": [
        "(.*[;&|(] *)?(curl|wget|nc|ncat|netcat|ssh|scp|sftp|rsync|telnet|env|printenv|aws|sudo)( .*)?",
        "(.*[;&|(] *)?(cat|less|more|head|tail) .*(~|\\$HOME|/Users/|/home/|/root/).*"
      ],
      "denyByDefault": true
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env/**",
          "**/.env.*",
          "**/.env.*/**",
          "**/*.env",
          "**/*.env/**",
          "**/*.env.*",
          "**/*.env.*/**",
          "**/*.envrc",
          "**/*.envrc/**",
          "**/*.pem",
          "**/*.pem/**",
          "**/*.key",
          "**/*.key/**",
          "**/*.p12",
          "**/*.p12/**",
          "**/*.pfx",
          "**/*.pfx/**",
          "**/*.ppk",
          "**/*.ppk/**",
          "**/*.jks",
          "**/*.jks/**",
          "**/*id_rsa*",
          "**/*id_rsa*/**",
          "**/*id_ed25519*",
          "**/*id_ed25519*/**",
          "**/*id_ecdsa*",
          "**/*id_ecdsa*/**",
          "**/*id_dsa*",
          "**/*id_dsa*/**",
          "**/*credentials*",
          "**/*credentials*/**",
          "**/*.secret*",
          "**/*.secret*/**",
          "**/*.npmrc",
          "**/*.npmrc/**",
          "**/*.netrc",
          "**/*.netrc/**",
          "**/*.pypirc",
          "**/*.pypirc/**",
          "**/*.pgpass",
          "**/*.pgpass/**",
          "**/*.tfvars",
          "**/*.tfvars/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "./**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/.env",
          "**/.env/**",
          "**/.env.*",
          "**/.env.*/**",
          "**/*.env",
          "**/*.env/**",
          "**/*.env.*",
          "**/*.env.*/**",
          "**/*.envrc",
          "**/*.envrc/**",
          "**/*.pem",
          "**/*.pem/**",
          "**/*.key",
          "**/*.key/**",
          "**/*.p12",
          "**/*.p12/**",
          "**/*.pfx",
          "**/*.pfx/**",
          "**/*.ppk",
          "**/*.ppk/**",
          "**/*.jks",
          "**/*.jks/**",
          "**/*id_rsa*",
          "**/*id_rsa*/**",
          "**/*id_ed25519*",
          "**/*id_ed25519*/**",
          "**/*id_ecdsa*",
          "**/*id_ecdsa*/**",
          "**/*id_dsa*",
          "**/*id_dsa*/**",
          "**/*credentials*",
          "**/*credentials*/**",
          "**/*.secret*",
          "**/*.secret*/**",
          "**/*.npmrc",
          "**/*.npmrc/**",
          "**/*.netrc",
          "**/*.netrc/**",
          "**/*.pypirc",
          "**/*.pypirc/**",
          "**/*.pgpass",
          "**/*.pgpass/**",
          "**/*.tfvars",
          "**/*.tfvars/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "cd voc-datalake",
          "cd */voc-datalake",
          "cd voc-datalake/frontend",
          "cd */voc-datalake/frontend",
          "cd voc-datalake/lambda/stream",
          "cd */voc-datalake/lambda/stream",
          "npx vitest run",
          "npx vitest run *",
          "npx vitest --run *",
          "python -m pytest",
          "python -m pytest *",
          "python3 -m pytest",
          "python3 -m pytest *",
          ".venv/bin/python -m pytest",
          ".venv/bin/python -m pytest *",
          "voc-datalake/.venv/bin/python -m pytest",
          "voc-datalake/.venv/bin/python -m pytest *",
          "node --test",
          "node --test *",
          "npm test",
          "npm test *",
          "npm run test*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "cd voc-datalake",
          "cd */voc-datalake",
          "cd voc-datalake/frontend",
          "cd */voc-datalake/frontend",
          "cd voc-datalake/lambda/stream",
          "cd */voc-datalake/lambda/stream",
          "npx vitest run",
          "npx vitest run *",
          "npx vitest --run *",
          "python -m pytest",
          "python -m pytest *",
          "python3 -m pytest",
          "python3 -m pytest *",
          ".venv/bin/python -m pytest",
          ".venv/bin/python -m pytest *",
          "voc-datalake/.venv/bin/python -m pytest",
          "voc-datalake/.venv/bin/python -m pytest *",
          "node --test",
          "node --test *",
          "npm test",
          "npm test *",
          "npm run test*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "curl",
          "curl *",
          "wget",
          "wget *",
          "nc",
          "nc *",
          "ncat",
          "ncat *",
          "netcat",
          "netcat *",
          "ssh",
          "ssh *",
          "scp",
          "scp *",
          "sftp",
          "sftp *",
          "rsync",
          "rsync *",
          "telnet",
          "telnet *",
          "env",
          "env *",
          "printenv",
          "printenv *",
          "aws",
          "aws *",
          "sudo",
          "sudo *",
          "cat *~*",
          "cat *$HOME*",
          "cat */Users/*",
          "cat */home/*",
          "cat */root/*",
          "less *~*",
          "less *$HOME*",
          "less */Users/*",
          "less */home/*",
          "less */root/*",
          "more *~*",
          "more *$HOME*",
          "more */Users/*",
          "more */home/*",
          "more */root/*",
          "head *~*",
          "head *$HOME*",
          "head */Users/*",
          "head */home/*",
          "head */root/*",
          "tail *~*",
          "tail *$HOME*",
          "tail */Users/*",
          "tail */home/*",
          "tail */root/*"
        ],
        "effect": "deny"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  }
