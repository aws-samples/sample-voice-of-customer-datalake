{
  "name": "first-principles-reviewer",
  "description": "Pre-push advisory agent — asks whether each thing a diff adds needs to exist, already exists, or fixes only a symptom; suggests subtractions only",
  "model": "claude-opus-4.6",
  "prompt": "file://./prompts/first-principles-reviewer.md",
  "tools": [
    "read",
    "thinking"
  ],
  "allowedTools": [
    "thinking"
  ],
  "resources": [
    "file://TENETS.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/coding-standards.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/product.md"
  ],
  "toolsSettings": {
    "fs_read": {
      "allowedPaths": [
        "./**"
      ],
      "deniedPaths": [
        "**/.env",
        "**/.env.*",
        "**/*.env",
        "**/*.env.*",
        "**/*.envrc",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx",
        "**/*.ppk",
        "**/*.jks",
        "**/*id_rsa*",
        "**/*id_ed25519*",
        "**/*id_ecdsa*",
        "**/*id_dsa*",
        "**/*credentials*",
        "**/*.secret*",
        "**/*.npmrc",
        "**/*.netrc",
        "**/*.pypirc",
        "**/*.pgpass",
        "**/*.tfvars"
      ]
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env/**",
          "**/.env.*",
          "**/.env.*/**",
          "**/*.env",
          "**/*.env/**",
          "**/*.env.*",
          "**/*.env.*/**",
          "**/*.envrc",
          "**/*.envrc/**",
          "**/*.pem",
          "**/*.pem/**",
          "**/*.key",
          "**/*.key/**",
          "**/*.p12",
          "**/*.p12/**",
          "**/*.pfx",
          "**/*.pfx/**",
          "**/*.ppk",
          "**/*.ppk/**",
          "**/*.jks",
          "**/*.jks/**",
          "**/*id_rsa*",
          "**/*id_rsa*/**",
          "**/*id_ed25519*",
          "**/*id_ed25519*/**",
          "**/*id_ecdsa*",
          "**/*id_ecdsa*/**",
          "**/*id_dsa*",
          "**/*id_dsa*/**",
          "**/*credentials*",
          "**/*credentials*/**",
          "**/*.secret*",
          "**/*.secret*/**",
          "**/*.npmrc",
          "**/*.npmrc/**",
          "**/*.netrc",
          "**/*.netrc/**",
          "**/*.pypirc",
          "**/*.pypirc/**",
          "**/*.pgpass",
          "**/*.pgpass/**",
          "**/*.tfvars",
          "**/*.tfvars/**"
        ],
        "effect": "deny"
      }
    ]
  }
}
