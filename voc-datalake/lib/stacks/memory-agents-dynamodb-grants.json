{
  "$comment": "The EXACT DynamoDB actions each memory/agents Lambda role holds, per table. Pinned on both sides: lib/stacks/memory-agents-stack.test.ts asserts the synthesized roles equal this file, and lambda/shared/test/strict_iam.py makes every moto-backed backend test answer AccessDenied for a call the Lambda's role would not allow (the voc-memory-scanner BatchGetItem outage). Change a grant in the stack and here together.",
  "tables": {
    "Memory": "MEMORY_TABLE",
    "Agents": "AGENTS_TABLE",
    "Aggregates": "AGGREGATES_TABLE",
    "Conversations": "CONVERSATIONS_TABLE",
    "Feedback": "FEEDBACK_TABLE",
    "Projects": "PROJECTS_TABLE"
  },
  "roles": {
