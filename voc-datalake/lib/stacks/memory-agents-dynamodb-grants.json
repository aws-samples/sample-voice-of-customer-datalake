          "dynamodb:PutItem",
          "dynamodb:Query",
          "dynamodb:UpdateItem"
        ],
        "Conversations": [
          "dynamodb:GetItem"
        ],
        "Aggregates": [
          "dynamodb:GetItem"
        ]
      }
    },
