{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // cdk.json's "app" runs bin/voc-datalake.ts; package.json scripts name the ts-node scripts. The test harness's own
  // entry of the app (the refused hard delete built, run by lib/test-support/synth-app.ts and the audit synth) is not
  // a production entry.
  "entry": ["bin/voc-datalake.ts!", "scripts/*.{ts,mjs}!", "scripts/capacity/*.ts!",
    "lib/test-support/hard-delete-app.ts"],
  "project": [
    "bin/**/*.ts!",
    "lib/**/*.ts!",
    "scripts/**/*.{ts,mjs}!",
    "!lib/**/*.{spec,test}.ts!",
    "!lib/**/*-fixtures.ts!",
    "!lib/test-support/**!"
  ],
  // Off: an export only its own file uses is a finding (nothing imports it, not even a spec).
  // ../scripts/knip-production.mjs turns it back on for --production, where an export its own file
  // uses and a spec imports is a testing seam.
  "ignoreExportsUsedInFile": false,
  // frontend/ and lambda/stream/ are separate packages (own package.json, own knip.jsonc); the
  // project globs above already keep them out of this run.
  "ignoreDependencies": [
    // Not imported: aws-cdk-lib's NodejsFunction shells out to it to bundle lambda/stream.
    "esbuild",
    // Type-only, from ../eslint-rules/*.mjs (JSDoc), outside this package's project globs;
    // tsconfig.tools.json maps "estree" to it. Removing it fails `tsc -p tsconfig.tools.json`.
    "@types/estree"
  ]
}
