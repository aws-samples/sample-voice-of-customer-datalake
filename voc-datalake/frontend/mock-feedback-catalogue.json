        "processor"
      ],
      "always_present": true,
      "key": true,
      "pii": "none",
      "under_redact": "kept",
      "under_summary_only": "kept"
    },
    {
      "name": "gsi4pk",
      "type": "string",
      "meaning": "`FEEDBACK#{feedback_id}` (index gsi4-by-feedback-id)",
