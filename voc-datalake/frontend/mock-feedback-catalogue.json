        "processor"
      ],
      "always_present": true,
      "key": true,
      "pii": "none",
      "under_redact": "kept",
      "under_summary_only": "kept"
    },
    {
      "name": "gsi2pk",
      "type": "string",
      "meaning": "`CATEGORY#{category}` (index gsi2-by-category)",
