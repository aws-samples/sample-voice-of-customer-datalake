{
  "version": 1,
  "table": "voc-feedback",
  "steps": [
    {
      "name": "producer",
      "meaning": "Copied from the queue message the source sent (plugin, webhook, import, feedback form), after the source policy (shared/source_policy.py) and the queue schema (shared/ingest_schemas.py)"
    },
    {
      "name": "processor",
      "meaning": "Computed by the feedback processor when it stores the item (lambda/processor/handler.py)"
    },
    {
      "name": "enrichment",
      "meaning": "Comprehend language and sentiment, Translate, and the enrichment model (shared/categorization.py run_enrichment)"
    },
    {
      "name": "classification",
      "meaning": "Dimension and tag resolution: message, source profile, category product, then the model (shared/feedback_dimensions.py)"
    },
    {
      "name": "provenance",
      "meaning": "How the item was made (shared/silver_provenance.py, TENETS.md D2)"
    },
    {
      "name": "storage_policy",
      "meaning": "The source's PII policy applied to the stored item (processor apply_storage_policy)"
    },
    {
      "name": "source_update",
      "meaning": "A newer copy from an update-capable source or a confirmed CSV correction (shared/source_updates.py, shared/csv_updates.py)"
    },
    {
      "name": "reprocess",
      "meaning": "A category reprocess job (lambda/jobs/category_reprocess)"
    },
    {
      "name": "edit",
      "meaning": "A person: PUT /feedback/{id}/category|dimensions, PUT /data-explorer/feedback"
    }
  ],
  "policy_effects": [
    {
      "name": "kept",
      "meaning": "stored as the producer sent it"
    },
    {
      "name": "redacted",
      "meaning": "personal data replaced by placeholders before anything is archived or queued"
    },
    {
      "name": "dropped",
      "meaning": "not stored"
    },
    {
      "name": "from_redacted",
      "meaning": "made from the redacted text"
    },
    {
      "name": "replaced",
      "meaning": "the model's problem_summary (or `[withheld]`) instead of the customer's words"
    }
  ],
  "fields": [
    {
      "name": "pk",
      "type": "string",
      "meaning": "`SOURCE#{brand_name}`: the partition of the source the item came from (an item of a workspace: every partition key here starts `WS#{ws}#`, docs/multi-workspace.md)",
      "set_by": [
        "processor"
      ],
      "always_present": true,
      "key": true,
      "pii": "none",
      "under_redact": "kept",
      "under_summary_only": "kept"
    },
    {
      "name": "sk",
      "type": "string",
      "meaning": "`FEEDBACK#{feedback_id}`",
      "set_by": [
        "processor"
      ],
      "always_present": true,
      "key": true,
      "pii": "none",
      "under_redact": "kept",
      "under_summary_only": "kept"
    },
    {
      "name": "gsi1pk",
      "type": "string",
      "meaning": "`DATE#{YYYY-MM-DD}` of processing (index gsi1-by-date)",
      "set_by": [
        "processor"
      ],
      "always_present": true,
      "key": true,
      "pii": "none",
      "under_redact": "kept",
      "under_summary_only": "kept"
    },
    {
      "name": "gsi1sk",
      "type": "string",
      "meaning": "`{processed_at}#{feedback_id}` (gsi1-by-date, gsi5-by-channel)",
