        "processor",
        "source_update",
        "reprocess",
        "edit"
      ],
      "always_present": true,
      "key": true,
      "pii": "none",
      "under_redact": "kept",
      "under_summary_only": "kept"
    },
    {
      "name": "gsi2sk",
      "type": "string",
      "meaning": "`{sentiment_score}#{processed_at}`",
