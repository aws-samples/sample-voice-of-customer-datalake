        "processor",
        "source_update"
      ],
      "always_present": true,
      "key": true,
      "pii": "none",
      "under_redact": "kept",
      "under_summary_only": "kept"
    },
    {
      "name": "gsi3sk",
      "type": "string",
      "meaning": "`processed_at` (gsi3-by-urgency)",
