{
  "name": "voc-analytics-frontend",
  "private": true,
  "version": "3.8.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "cd .. && npm run generate:manifests && npm run generate:menu",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "mock": "node mock-server.js",
    "check:mock": "node scripts/check-mock-coverage.mjs",
    "e2e:prod": "npm --prefix e2e ci --no-audit --no-fund && npm --prefix e2e test",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc -b --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "i18n:extract": "npx i18next-parser",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:validate": "npx i18next-parser && node scripts/i18n-check.mjs",
    "deploy:frontend": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@tanstack/react-query": "^5.90.10",
    "@xyflow/react": "12.12.0",
    "amazon-cognito-identity-js": "^6.3.17",
    "aws-amplify": "^6.16.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.9.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.554.0",
    "qrcode.react": "4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.5.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.17",
    "zod": "4.6.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "^4.1.9",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-sonarjs": "^4.0.0",
    "eslint-plugin-unicorn": "63.0.0",
    "globals": "^16.5.0",
    "i18next-parser": "^9.4.0",
    "jsdom": "^26.1.0",
    "knip": "6.37.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
