{
  "name": "voc-analytics-frontend",
  "private": true,
  "version": "5.70.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "cd .. && npm run generate:manifests && npm run generate:menu",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "mock": "node mock-server.js",
    "check:mock": "node scripts/check-mock-coverage.mjs",
    "e2e:prod": "npm --prefix e2e ci --no-audit --no-fund && npm --prefix e2e test",
    "e2e:prod:sharded": "npm --prefix e2e ci --no-audit --no-fund && bash e2e/scripts/run-sharded.sh",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc -b --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "i18n:extract": "npx i18next-parser",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:validate": "npx i18next-parser && node scripts/i18n-check.mjs",
    "deploy:frontend": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.3",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@xyflow/react": "12.12.0",
    "aws-amplify": "^6.22.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.4",
    "i18next-http-backend": "^4.0.7",
    "lucide-react": "^0.577.0",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "^4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "63.0.0",
    "globals": "^16.5.0",
    "i18next-parser": "^9.4.0",
    "jsdom": "^26.1.0",
    "knip": "6.44.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.17.1"
    },
    "esbuild": "^0.28.1"
  }
}
