{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voc-orchestration:bundle",
  "title": "voc-orchestration-bundle/1: the compiled templates (bundle.json)",
  "description": "GENERATED by `npm run orchestration:compile` from this folder, committed, and drift-checked by `npm run orchestration:validate` (D-2). A byte-identical copy ships in the Lambdas as lambda/shared/orchestration_bundle.json. Readers: shared/engineering_templates.py (GET /workflows/templates), shared/agent_seed.py (the seeded agents), engineering/orchestration/bundle.py (the skills, the platform rules, the gates), the web app (frontend/src/api/engineeringTemplates.ts).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "note", "source_digest", "platform_rules", "agents", "flows", "automations", "gates", "evals",
               "sources", "library"],
  "properties": {
    "schema": {"const": "voc-orchestration-bundle/1"},
    "note": {"type": "string"},
    "source_digest": {"description": "sha256 of every source file the bundle was compiled from (paths and bytes).",
                      "$ref": "#/$defs/digest"},
    "platform_rules": {
      "description": "_shared/PLATFORM_RULES.md: the rules the harness wraps around every skill (never in a skill version).",
      "type": "object", "additionalProperties": false, "required": ["text", "digest"],
      "properties": {"text": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}},
    "flows": {"type": "array", "items": {"$ref": "#/$defs/flow"}},
    "automations": {"type": "array", "items": {"$ref": "#/$defs/automation"}},
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["packs", "aliases", "own_gate", "messages", "stops", "briefs"],
      "properties": {
        "packs": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "languages", "image", "network", "tools", "steps", "briefs"],
          "properties": {
            "id": {"type": "string"}, "name": {"type": "string"},
            "languages": {"type": "array", "items": {"type": "string"}},
            "image": {"type": "object", "additionalProperties": {"type": "string"}},
            "network": {"type": "array", "items": {"type": "string"}},
            "tools": {"description": "The tools whose versions the gate records (the manifest's [tools]).",
                      "type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["name", "version_argv"],
              "properties": {"name": {"type": "string"}, "version_argv": {"type": "array", "items": {"type": "string"}}}
            }},
            "steps": {"description": "The manifest's [[steps]], every field (7.52.00: the Registry's Quality gates view).",
                      "type": "array", "items": {"$ref": "#/$defs/gate_step"}},
            "briefs": {"description": "The owner's briefs that are the source of truth for the pack (gates.briefs ids).",
                       "type": "array", "items": {"type": "string"}}
          }
        }},
        "aliases": {"description": "Pack ids a stored flow may still name, and the packs each stands for.",
                    "type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "own_gate": {"description": "The repository's own gate: where it exists, it runs instead of every pack step.",
                     "type": "object", "additionalProperties": false, "required": ["file", "argv", "timeout_s"],
                     "properties": {"file": {"type": "string"}, "argv": {"type": "array", "items": {"type": "string"}},
                                    "timeout_s": {"type": "integer"}}},
        "messages": {"description": "What the gate record says of a check that did not pass, by what happened: the gate's own words with their {placeholders} (7.52.00).",
                     "type": "object", "additionalProperties": false,
                     "required": ["missing_tool", "timeout", "empty_exit", "empty_output", "fail", "setup_failed"],
                     "properties": {"missing_tool": {"type": "string"}, "timeout": {"type": "string"},
                                    "empty_exit": {"type": "string"}, "empty_output": {"type": "string"},
                                    "fail": {"type": "string"}, "setup_failed": {"type": "string"}}},
        "stops": {"description": "7.54.00: the gate's own reasons for a STOPPED record (quality_gate/packs.py STOPS), each with what it means: no check judged the code, so a person decides and no revision starts.",
                  "type": "object", "additionalProperties": false,
                  "required": ["setup_failed", "nothing_checked", "tool_missing"],
                  "properties": {"setup_failed": {"type": "string"}, "nothing_checked": {"type": "string"},
                                 "tool_missing": {"type": "string"}}},
        "briefs": {"description": "The owner's quality-gate briefs (gates/briefs/<id>.md), each the source of truth for its packs (7.52.00).",
                   "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "path", "packs", "digest", "bytes", "text"],
          "properties": {
            "id": {"type": "string"}, "path": {"type": "string"},
            "packs": {"type": "array", "items": {"type": "string"}},
            "digest": {"$ref": "#/$defs/digest"}, "bytes": {"type": "integer"}, "text": {"type": "string", "minLength": 1}
          }
        }}
      }
    },
    "evals": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["flow", "id", "kind"],
      "properties": {
        "flow": {"type": "string"}, "id": {"type": "string"},
        "kind": {"description": "bug, feature and review: voc-bench/1 cases the benchmark runs; triage: an Issue triage case.",
                 "enum": ["bug", "feature", "review", "triage"]}
      }
    }},
    "library": {
      "description": "7.56.00: the skills library (skills/<name>/), by name: each skill's front matter, its SKILL.md (text, front matter included), its reference files, and the roles whose cards name it (in role order). The harness's read_skill answers from it; the app's Skills → Library reads it (GET /agents/engineering/skill-library).",
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "description", "source", "license", "adapted", "path", "digest", "bytes", "text", "roles",
                     "references"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"}, "description": {"type": "string"},
          "source": {"type": "string"}, "license": {"type": "string"}, "adapted": {"type": "string"},
          "path": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}, "bytes": {"type": "integer"},
          "text": {"type": "string", "minLength": 1},
          "roles": {"type": "array", "items": {"type": "string"}},
          "references": {"type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "digest", "bytes", "text"],
            "properties": {"path": {"type": "string", "pattern": "^references/[A-Za-z0-9][A-Za-z0-9_.-]*\\.md$"},
                           "digest": {"$ref": "#/$defs/digest"}, "bytes": {"type": "integer"},
                           "text": {"type": "string", "minLength": 1}}
          }}
        }
      }
    },
    "sources": {
      "description": "7.52.00: each template's source text as the repository holds it, for the app's read-only source view (GET /agents/engineering/templates/<kind>/<id>/source): a role's SKILL.md (kind skill) and agent.yaml (card), a flow's YAML (flow). A gate brief's text is gates.briefs'.",
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "id", "path", "text", "digest", "template_version"],
        "properties": {
          "kind": {"enum": ["skill", "card", "flow"]}, "id": {"type": "string"}, "path": {"type": "string"},
          "text": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"},
          "template_version": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gate_condition": {
      "description": "A step's condition: exactly one of file, glob and absent, with contains or npm_script on a file.",
      "type": "object", "additionalProperties": false,
      "properties": {"file": {"type": "string"}, "glob": {"type": "string"}, "absent": {"type": "string"},
                     "contains": {"type": "string"}, "npm_script": {"type": "string"}}
    },
    "gate_step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "language", "name", "kind", "argv", "timeout_s", "when_any", "prefer", "empty_exit_codes",
                   "expect_output"],
      "properties": {
        "id": {"type": "string"}, "language": {"type": "string"}, "name": {"type": "string"}, "kind": {"type": "string"},
        "argv": {"type": "array", "items": {"type": "string"}}, "timeout_s": {"type": "integer"},
        "when_any": {"type": "array", "items": {"$ref": "#/$defs/gate_condition"}},
        "prefer": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["when", "argv"],
          "properties": {"when": {"type": "array", "items": {"$ref": "#/$defs/gate_condition"}},
                         "argv": {"type": "array", "items": {"type": "string"}}}
        }},
        "empty_exit_codes": {"type": "array", "items": {"type": "integer"}},
        "expect_output": {"type": "string"}
      }
    },
    "skill_record": {
      "description": "A voc-skill/1 record, exactly as runtime/harness/skills.py Skill.to_record writes it.",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "name", "version", "instructions", "examples", "tool_policy", "model", "harness"],
      "properties": {
        "schema": {"const": "voc-skill/1"},
        "name": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "instructions": {"type": "string", "minLength": 1, "maxLength": 20000},
        "examples": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["situation", "action"],
          "properties": {"situation": {"type": "string"}, "action": {"type": "string"}}
        }},
        "tool_policy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "model": {"type": "string"},
        "harness": {"enum": ["converse", "cli"]}
      }
    },
    "agent": {
      "description": "One role's card as compiled; skill is its voc-skill/1 record (null for the Learn card).",
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "label", "digest", "purpose", "harness", "model", "tools", "pending_tools",
                   "broker_ops", "pending_broker_ops", "caps", "trust", "inputs", "outputs", "evals", "allowed_tools",
                   "skills", "skill"],
      "properties": {
        "allowed_tools": {"description": "Every tool the role may have (role_specs), whatever a skill names: a Registry card's tools are a subset of these (7.52.00). Not in the digest.",
                          "type": "array", "items": {"type": "string"}},
        "id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "label": {"description": "<role>@template-<version>: the bundled template as a session row names it.",
                  "type": "string", "pattern": "^[a-z-]+@template-[0-9]+$"},
        "digest": {"description": "sha256 of the card and the skill record: the template_digest a skill version keeps.",
                   "$ref": "#/$defs/digest"},
        "purpose": {"type": "string"},
        "harness": {"enum": ["converse", "cli", "learn"]},
        "model": {"type": "string"},
        "model_choice": {"description": "7.58.00: the card's model choice (its model.choice or model.other), only when it names one: in the digest only then.",
                         "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
        "tools": {"type": "array", "items": {"type": "string"}},
        "pending_tools": {"type": "array", "items": {"type": "string"}},
        "broker_ops": {"type": "array", "items": {"type": "string"}},
        "pending_broker_ops": {"type": "array", "items": {"type": "string"}},
        "caps": {"type": "object"},
        "trust": {"type": "object"},
        "inputs": {"type": "array"},
        "outputs": {"type": "array"},
        "evals": {"type": "array", "items": {"type": "string"}},
        "skills": {"description": "7.56.00: the library skills the card names (the bundle's library), [] for none.",
                   "type": "array", "items": {"type": "string"}},
        "skill": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/skill_record"}]}
      }
    },
    "flow": {
      "description": "One flow template: GET /workflows/templates serves template_id, name, description and definition.",
      "type": "object", "additionalProperties": false,
      "required": ["template_id", "version", "name", "description", "budget", "memory", "learn", "pr", "requires",
                   "inputs", "skills", "evals", "definition"],
      "properties": {
        "template_id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "budget": {"type": "object"},
        "memory": {"type": "object"},
        "learn": {"type": "object"},
        "pr": {"enum": ["ready", "draft", null]},
        "requires": {"type": "object"},
        "inputs": {"type": "object"},
        "skills": {"description": "Each step's skill reference (<role>@latest), the gate's runner and final go included.",
                   "type": "object", "additionalProperties": {"type": "string"}},
        "evals": {"type": "array", "items": {"type": "string"}},
        "definition": {"description": "A voc-workflow/2 definition that shared/workflow_schema.py keeps as it is.",
                       "type": "object", "required": ["schema", "name", "nodes", "edges", "loops"],
                       "properties": {"schema": {"const": "voc-workflow/2"}}}
      }
    },
    "automation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "name", "seed_marker", "flow", "monthly_budget_usd", "requires_triage", "learn",
                   "pr", "readiness", "body"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "name": {"type": "string"},
        "seed_marker": {"type": "object", "required": ["pk", "sk"]},
        "flow": {"type": "string"},
        "monthly_budget_usd": {"type": ["number", "null"]},
        "requires_triage": {"enum": ["bug", "feature", null]},
        "learn": {"type": ["object", "null"]},
        "pr": {"enum": ["ready", "draft", null]},
        "readiness": {"type": "array", "items": {"type": "string"}},
        "body": {"description": "The agent body agent_seed creates (store.normalize_agent's input).", "type": "object"}
      }
    }
  }
}
