{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voc-orchestration:bundle",
  "title": "voc-orchestration-bundle/1: the compiled templates (bundle.json)",
  "description": "GENERATED by `npm run orchestration:compile` from this folder, committed, and drift-checked by `npm run orchestration:validate` (D-2). A byte-identical copy ships in the Lambdas as lambda/shared/orchestration_bundle.json. Readers: shared/engineering_templates.py (GET /workflows/templates), shared/agent_seed.py (the seeded agents), engineering/orchestration/bundle.py (the skills, the platform rules, the gates), the web app (frontend/src/api/engineeringTemplates.ts).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "note", "source_digest", "platform_rules", "agents", "flows", "automations", "gates", "evals"],
  "properties": {
    "schema": {"const": "voc-orchestration-bundle/1"},
    "note": {"type": "string"},
    "source_digest": {"description": "sha256 of every source file the bundle was compiled from (paths and bytes).",
                      "$ref": "#/$defs/digest"},
    "platform_rules": {
      "description": "_shared/PLATFORM_RULES.md: the rules the harness wraps around every skill (never in a skill version).",
      "type": "object", "additionalProperties": false, "required": ["text", "digest"],
      "properties": {"text": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}},
    "flows": {"type": "array", "items": {"$ref": "#/$defs/flow"}},
    "automations": {"type": "array", "items": {"$ref": "#/$defs/automation"}},
    "gates": {
      "type": "object", "additionalProperties": false, "required": ["packs", "aliases"],
      "properties": {
        "packs": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "name", "languages", "image", "network"],
          "properties": {
            "id": {"type": "string"}, "name": {"type": "string"},
            "languages": {"type": "array", "items": {"type": "string"}},
            "image": {"type": "object", "additionalProperties": {"type": "string"}},
            "network": {"type": "array", "items": {"type": "string"}}
          }
        }},
        "aliases": {"description": "Pack ids a stored flow may still name, and the packs each stands for.",
                    "type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "evals": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["flow", "id", "kind"],
      "properties": {
        "flow": {"type": "string"}, "id": {"type": "string"},
        "kind": {"description": "bug, feature and review: voc-bench/1 cases the benchmark runs; triage: an Issue triage case.",
                 "enum": ["bug", "feature", "review", "triage"]}
      }
    }}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "skill_record": {
      "description": "A voc-skill/1 record, exactly as runtime/harness/skills.py Skill.to_record writes it.",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "name", "version", "instructions", "examples", "tool_policy", "model", "harness"],
      "properties": {
        "schema": {"const": "voc-skill/1"},
        "name": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "instructions": {"type": "string", "minLength": 1, "maxLength": 20000},
        "examples": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["situation", "action"],
          "properties": {"situation": {"type": "string"}, "action": {"type": "string"}}
        }},
        "tool_policy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "model": {"type": "string"},
        "harness": {"enum": ["converse", "cli"]}
      }
    },
    "agent": {
      "description": "One role's card as compiled; skill is its voc-skill/1 record (null for the Learn card).",
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "label", "digest", "purpose", "harness", "model", "tools", "pending_tools",
                   "broker_ops", "pending_broker_ops", "caps", "trust", "inputs", "outputs", "evals", "skill"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "label": {"description": "<role>@template-<version>: the bundled template as a session row names it.",
                  "type": "string", "pattern": "^[a-z-]+@template-[0-9]+$"},
        "digest": {"description": "sha256 of the card and the skill record: the template_digest a skill version keeps.",
                   "$ref": "#/$defs/digest"},
        "purpose": {"type": "string"},
        "harness": {"enum": ["converse", "cli", "learn"]},
        "model": {"type": "string"},
        "tools": {"type": "array", "items": {"type": "string"}},
        "pending_tools": {"type": "array", "items": {"type": "string"}},
        "broker_ops": {"type": "array", "items": {"type": "string"}},
        "pending_broker_ops": {"type": "array", "items": {"type": "string"}},
        "caps": {"type": "object"},
        "trust": {"type": "object"},
        "inputs": {"type": "array"},
        "outputs": {"type": "array"},
        "evals": {"type": "array", "items": {"type": "string"}},
        "skill": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/skill_record"}]}
      }
    },
    "flow": {
      "description": "One flow template: GET /workflows/templates serves template_id, name, description and definition.",
      "type": "object", "additionalProperties": false,
      "required": ["template_id", "version", "name", "description", "budget", "memory", "learn", "pr", "requires",
                   "inputs", "skills", "evals", "definition"],
      "properties": {
        "template_id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "budget": {"type": "object"},
        "memory": {"type": "object"},
        "learn": {"type": "object"},
        "pr": {"enum": ["ready", "draft", null]},
        "requires": {"type": "object"},
        "inputs": {"type": "object"},
        "skills": {"description": "Each step's skill reference (<role>@latest), the gate's runner and final go included.",
                   "type": "object", "additionalProperties": {"type": "string"}},
        "evals": {"type": "array", "items": {"type": "string"}},
        "definition": {"description": "A voc-workflow/2 definition that shared/workflow_schema.py keeps as it is.",
                       "type": "object", "required": ["schema", "name", "nodes", "edges", "loops"],
                       "properties": {"schema": {"const": "voc-workflow/2"}}}
      }
    },
    "automation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "name", "seed_marker", "flow", "monthly_budget_usd", "requires_triage", "learn",
                   "pr", "readiness", "body"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "name": {"type": "string"},
        "seed_marker": {"type": "object", "required": ["pk", "sk"]},
        "flow": {"type": "string"},
        "monthly_budget_usd": {"type": ["number", "null"]},
        "requires_triage": {"enum": ["bug", "feature", null]},
        "learn": {"type": ["object", "null"]},
        "pr": {"enum": ["ready", "draft", null]},
        "readiness": {"type": "array", "items": {"type": "string"}},
        "body": {"description": "The agent body agent_seed creates (store.normalize_agent's input).", "type": "object"}
      }
    }
  }
}
