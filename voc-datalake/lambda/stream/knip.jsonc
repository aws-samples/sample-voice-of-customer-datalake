{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The Lambda handlers, each bundled by esbuild (`entry:`): the assistant (lib/stacks/api-assistant-lambdas.ts)
  // and the plan-step runner voc-plan-step (VocProcessingStack). scripts/write-plan-contract.mjs is run by
  // hand (regenerates lambda/shared/plan_contract.json); contract-json.ts, which it prints, is the plan
  // contract's generator: never bundled, but production contract code (its spec pins the committed file).
  "entry": [
    "src/handler.ts!",
    "src/plan-step/handler.ts!",
    "src/assistant/plan/contract-json.ts!",
    "scripts/write-plan-contract.mjs"
  ],
  "project": [
    "src/**/*.ts!",
    "!src/**/*.{spec,test}.ts!",
    "!src/**/*-fixtures.ts!",
    "!src/**/__fixtures__/**!"
  ],
  // Off: an export only its own file uses is a finding (nothing imports it, not even a spec).
  // ../../../scripts/knip-production.mjs turns it back on for --production, where an export its own
  // file uses and a spec imports is a testing seam.
  "ignoreExportsUsedInFile": false,
  // Each entry is an export nothing imports ON PURPOSE. Do not add one without its reason.
  "ignoreIssues": {
    // The AG-UI wire contract, shared with the SPA: frontend/src imports it through `@stream`, which
    // this package's knip does not scan, so the names only the SPA reads (STALE_RUN_SECONDS,
    // mentionsSchema) and the documented constants of the protocol (the page → pack table, the tool
    // outcome statuses, the plan interrupt reason and id prefix, maxFilterChars) stay exported here.
    "src/assistant/contract.ts": ["exports"]
  }
}
