{
  "$comment": "GENERATED from lambda/stream/src/assistant/plan/schema.ts + contract.ts — do not edit. Regenerate: cd voc-datalake/lambda/stream && npx jiti scripts/write-plan-contract.mjs > ../shared/plan_contract.json",
  "schema": "voc-plan/1",
  "limits": {
    "steps": 20,
    "writes": 12,
    "waits": 6,
    "thinks": 4,
    "approvalTtlMinutes": 30,
    "startTtlHours": 24,
    "modelCalls": 60,
    "jobs": 6
  },
  "field_limits": {
    "goalChars": 500,
    "titleChars": 120,
    "briefChars": 2000,
    "afterItems": 20,
    "producesItems": 8,
    "argKeyChars": 64,
    "planJsonChars": 64000,
    "waitTimeoutMinutesMax": 1440
  },
  "patterns": {
    "plan_id": "^pl_[0-9a-f]{12}$",
    "step_id": "^s\\d{1,3}$",
    "output_name": "^[a-z_]{1,32}$",
    "reference": "^\\{\\{(s\\d{1,3})\\.([a-z_]{1,32})\\}\\}$",
    "wait_value": "^(?:[\\w.:-]{1,128}|\\{\\{s\\d{1,3}\\.[a-z_]{1,32}\\}\\})$",
    "source_id": "^[a-z0-9_]{1,64}$"
  },
  "free_placeholder": "{{free}}",
  "think_default_output": "summary",
  "step_kinds": [
    "write",
    "wait",
    "think"
  ],
  "wait_kinds": [
    "source_run",
    "project_job",
    "scraper_run"
  ],
  "step_statuses": [
    "pending",
    "running",
    "waiting",
    "done",
    "failed",
    "skipped",
    "needs_approval",
    "cancelled"
  ],
  "plan_statuses": [
    "awaiting_approval",
    "approved",
    "running",
    "completed",
    "completed_with_errors",
    "failed",
    "cancelled",
    "expired"
  ],
