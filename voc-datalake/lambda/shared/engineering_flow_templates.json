  {
   "template_id": "pr-review",
   "name": "PR review",
   "description": "Reviews a pull request in one pass, its pages in parallel, against the repository's tenets and review guide, and leaves review comments.",
   "definition": {
    "schema": "voc-workflow/2",
    "name": "PR review",
    "description": "Reviews a pull request in one pass, its pages in parallel, against the repository's tenets and review guide, and leaves review comments.",
    "nodes": [
     {
      "id": "start",
      "type": "start",
      "position": {
       "x": 0,
       "y": 0
      },
      "data": {
       "title": "Start",
       "params": {}
      }
     },
     {
      "id": "memory",
      "type": "memory",
      "position": {
       "x": 0,
       "y": 120
      },
      "data": {
       "title": "Recall the tenets and review guide",
       "params": {
        "mode": "read",
        "scope": "repo",
        "limit": 10
       }
      }
     },
     {
      "id": "map",
      "type": "map",
      "position": {
       "x": 0,
       "y": 240
      },
      "data": {
       "title": "Split the pull request",
       "params": {
        "shard_by": "pr_pages",
        "shard_cap": 50
       }
      }
     },
     {
      "id": "review",
      "type": "agent",
      "position": {
       "x": 0,
       "y": 360
      },
      "data": {
       "title": "Review each page",
       "params": {
        "role": "pr-reviewer"
       }
      }
     },
     {
      "id": "reduce",
      "type": "reduce",
      "position": {
       "x": 0,
       "y": 480
      },
      "data": {
       "title": "Bring the reviews together",
       "params": {}
      }
     },
     {
      "id": "comment",
      "type": "agent",
      "position": {
       "x": 0,
       "y": 600
      },
      "data": {
       "title": "Leave the review comments",
       "params": {
        "role": "pr-reviewer"
       },
       "instructions": "Comment on the pull request only: never approve, push to or merge it."
