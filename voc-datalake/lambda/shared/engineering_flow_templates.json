  {
   "template_id": "issue-triage",
   "name": "Issue triage",
   "description": "Reads an issue, classifies it as a bug, a feature or an investigation, reproduces or locates it and proposes the next step on the issue.",
   "definition": {
    "schema": "voc-workflow/2",
    "name": "Issue triage",
    "description": "Reads an issue, classifies it as a bug, a feature or an investigation, reproduces or locates it and proposes the next step on the issue.",
    "nodes": [
     {
      "id": "start",
      "type": "start",
      "position": {
       "x": 0,
       "y": 0
      },
      "data": {
       "title": "Start",
       "params": {}
      }
     },
     {
      "id": "memory",
      "type": "memory",
      "position": {
       "x": 0,
       "y": 120
      },
      "data": {
       "title": "Recall the repository",
       "params": {
        "mode": "read",
        "scope": "repo",
        "limit": 10
       }
      }
     },
     {
      "id": "classify",
      "type": "agent",
      "position": {
       "x": 0,
       "y": 240
      },
      "data": {
       "title": "Understand and classify",
       "params": {
        "role": "understander"
       },
       "instructions": "Classify the issue as a bug, a feature or an investigation, and say why."
      }
     },
     {
      "id": "locate",
      "type": "agent",
      "position": {
       "x": 0,
       "y": 360
      },
      "data": {
       "title": "Reproduce or locate",
       "params": {
        "role": "hunter"
       }
      }
     },
     {
      "id": "propose",
      "type": "agent",
      "position": {
       "x": 0,
       "y": 480
      },
      "data": {
       "title": "Propose the next step",
       "params": {
        "role": "understander"
       },
       "instructions": "Write the proposal on the issue: what it is, where it lives and what to do next."
      }
     },
     {
      "id": "end",
      "type": "end",
      "position": {
       "x": 0,
       "y": 600
      },
      "data": {
       "title": "The proposal on the issue",
       "params": {
        "status": "completed"
       }
      }
     }
    ],
    "edges": [
     {
      "id": "start-memory",
      "source": "start",
      "target": "memory"
     },
     {
      "id": "memory-classify",
      "source": "memory",
      "target": "classify"
     },
     {
      "id": "classify-locate",
      "source": "classify",
      "target": "locate"
     },
     {
      "id": "locate-propose",
      "source": "locate",
      "target": "propose"
     },
     {
      "id": "propose-end",
      "source": "propose",
      "target": "end"
     }
    ],
    "loops": []
   }
  },
  {
   "template_id": "bug-hunt-and-fix",
   "name": "Bug hunt and fix",
   "description": "Hunts bugs in the packages it is given, fixes and reviews each one, runs the quality gate and stops at a draft pull request.",
   "definition": {
    "schema": "voc-workflow/2",
    "name": "Bug hunt and fix",
    "description": "Hunts bugs in the packages it is given, fixes and reviews each one, runs the quality gate and stops at a draft pull request.",
    "nodes": [
     {
      "id": "start",
      "type": "start",
      "position": {
       "x": 0,
       "y": 0
      },
      "data": {
       "title": "Start",
       "params": {}
      }
     },
     {
      "id": "hunt",
      "type": "agent",
      "position": {
       "x": 0,
       "y": 120
      },
      "data": {
       "title": "Hunt bugs",
       "params": {
        "role": "hunter"
       }
      }
     },
     {
      "id": "board",
      "type": "board",
      "position": {
       "x": 0,
       "y": 240
      },
      "data": {
       "title": "Understand, fix and review each bug",
       "params": {
        "posters": [
         "hunter"
        ],
        "claimers": [
         "understander",
         "fixer",
         "commit-reviewer"
        ],
        "until": "drained"
       }
      }
     },
     {
      "id": "gate",
      "type": "quality_gate",
      "position": {
       "x": 0,
       "y": 360
      },
      "data": {
       "title": "Quality gate",
       "params": {
        "max_rounds": 3,
        "packs": "auto"
       }
      }
     },
     {
      "id": "commit",
      "type": "agent",
      "position": {
       "x": 0,
       "y": 480
      },
      "data": {
       "title": "Commit the fix the gate passed",
       "params": {
        "role": "committer"
       },
       "instructions": "Commit the fixer's submitted patch, the tree the gate's GO names, to the run's branch."
      }
     },
     {
      "id": "pr_author",
      "type": "agent",
      "position": {
       "x": 0,
       "y": 600
      },
      "data": {
       "title": "Open the draft pull request",
       "params": {
        "role": "pr-author"
       },
       "instructions": "Open a draft pull request for each fix: the bug it fixes (how it showed and where), what was changed to fix it and the feedback ids it cites. Never merge."
      }
     },
     {
      "id": "pr",
      "type": "stop_at_pr",
      "position": {
       "x": 0,
       "y": 720
      },
      "data": {
       "title": "Draft pull request",
       "params": {}
      }
     },
     {
      "id": "human",
      "type": "end",
      "position": {
       "x": 280,
       "y": 480
      },
      "data": {
       "title": "A person decides",
       "params": {
        "status": "needs_human"
       }
      }
     }
    ],
    "edges": [
     {
      "id": "start-hunt",
      "source": "start",
      "target": "hunt"
     },
     {
      "id": "hunt-board",
      "source": "hunt",
      "target": "board"
     },
     {
      "id": "board-gate",
      "source": "board",
      "target": "gate"
     },
     {
      "id": "gate-commit",
      "source": "gate",
      "target": "commit",
      "label": "pass"
     },
     {
      "id": "commit-pr_author",
      "source": "commit",
      "target": "pr_author"
     },
     {
      "id": "pr_author-pr",
      "source": "pr_author",
      "target": "pr"
     },
     {
      "id": "gate-human",
      "source": "gate",
      "target": "human",
      "label": "fail"
     }
    ],
    "loops": []
   }
  },
  {
