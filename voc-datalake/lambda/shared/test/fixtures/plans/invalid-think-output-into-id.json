{
  "description": "invalid think output into id",
  "ctx": {
    "isAdmin": true,
    "packsAllowed": [
      "core",
      "insights",
      "project",
      "forms",
      "prioritization",
      "scrapers",
      "settings",
      "memory",
      "agents",
      "company"
    ]
  },
  "plan": {
    "schema": "voc-plan/1",
    "goal": "Create a checkout project and derive personas",
    "steps": [
      {
        "id": "s9",
        "pack": "insights",
        "kind": "think",
        "title": "Pick",
        "think": {
          "brief": "Pick a project."
        },
        "produces": [
          "project_id"
        ]
      },
      {
        "id": "s1",
        "pack": "core",
        "kind": "write",
        "title": "Create the project",
        "write": {
          "tool": "create_project",
          "args": {
            "name": "Checkout"
          }
        },
        "produces": [
          "project_id"
        ]
      },
      {
        "id": "s2",
        "pack": "project",
        "kind": "write",
        "after": [
          "s1",
          "s9"
        ],
        "title": "Generate personas",
        "write": {
          "tool": "generate_personas",
          "args": {
            "project_id": "{{s9.project_id}}",
            "persona_count": 3,
            "custom_instructions": "Checkout customers, from their checkout reviews only"
          }
        },
        "produces": [
          "job_id"
        ]
      }
    ]
  },
  "valid": false,
  "errors": [
    {
      "step": "s2",
      "field": "write.args.project_id"
    }
  ],
  "needs_args_schema": false
}
