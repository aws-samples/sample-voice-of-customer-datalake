{
  "description": "valid example",
  "ctx": {
    "isAdmin": true,
    "packsAllowed": [
      "core",
      "insights",
      "project",
      "forms",
      "prioritization",
      "scrapers",
      "settings",
      "memory",
      "agents",
      "company"
    ]
  },
  "plan": {
    "schema": "voc-plan/1",
    "goal": "Example Air: import iOS reviews, find problems, ancillaries project with personas, PR/FAQ, prototype",
    "steps": [
      {
        "id": "s1",
        "pack": "scrapers",
        "kind": "write",
        "title": "Connect the ExampleAir iOS app",
        "write": {
          "tool": "create_app_connector",
          "args": {
            "source": "app_reviews_ios",
            "app_id": "1234567890",
            "app_name": "ExampleAir iOS"
          }
        },
        "produces": [
          "app_config_id"
        ]
      },
      {
        "id": "s2",
        "pack": "scrapers",
        "kind": "write",
        "after": [
          "s1"
        ],
        "title": "Import the iOS reviews",
        "write": {
          "tool": "run_source",
          "args": {
            "source": "app_reviews_ios"
          }
        },
        "produces": [
          "execution_id"
        ]
      },
      {
        "id": "s3",
        "pack": "scrapers",
        "kind": "wait",
        "after": [
          "s2"
        ],
        "title": "Wait for the import",
        "wait": {
          "for": "source_run",
          "source": "app_reviews_ios",
          "execution_id": "{{s2.execution_id}}",
          "timeout_minutes": 60
        }
      },
      {
        "id": "s4",
        "pack": "insights",
        "kind": "think",
        "after": [
          "s3"
        ],
        "title": "What Example Air does wrong",
        "think": {
          "brief": "Summarise the main problems in the Example Air reviews, with counts and quotes."
        },
        "produces": [
          "summary"
        ]
      },
      {
        "id": "s5",
        "pack": "core",
        "kind": "write",
        "title": "Create the ancillaries project",
        "write": {
          "tool": "create_project",
          "args": {
            "name": "Example Air - Ancillaries",
            "description": "{{free}}"
          }
        },
        "produces": [
          "project_id"
        ]
      },
      {
        "id": "s6",
        "pack": "project",
        "kind": "write",
        "after": [
          "s4",
          "s5"
        ],
        "title": "Generate personas",
        "write": {
          "tool": "generate_personas",
          "args": {
            "project_id": "{{s5.project_id}}",
            "persona_count": 4,
            "custom_instructions": "Example Air customers, from the ExampleAir iOS app reviews only",
            "sources": [
              "ExampleAir iOS_iOS"
            ]
          }
        },
        "produces": [
          "job_id"
        ]
      },
      {
        "id": "s7",
        "pack": "project",
        "kind": "wait",
        "after": [
          "s6"
        ],
        "title": "Wait for the personas",
        "wait": {
          "for": "project_job",
          "project_id": "{{s5.project_id}}",
          "job_id": "{{s6.job_id}}"
        }
      },
      {
        "id": "s8",
        "pack": "project",
        "kind": "write",
        "after": [
          "s7"
        ],
        "title": "Write the PR/FAQ",
        "write": {
          "tool": "generate_document",
          "args": {
            "project_id": "{{s5.project_id}}",
            "doc_type": "prfaq",
            "title": "Ancillaries PR/FAQ",
            "feature_idea": "Ancillaries for Example Air travellers (hotels, cars, eSIM), from the ExampleAir iOS app reviews only",
            "sources": [
              "ExampleAir iOS_iOS"
            ]
          }
        },
        "produces": [
          "job_id"
        ]
      },
      {
        "id": "s9",
        "pack": "project",
        "kind": "wait",
        "after": [
          "s8"
        ],
        "title": "Wait for the PR/FAQ",
        "wait": {
          "for": "project_job",
          "project_id": "{{s5.project_id}}",
          "job_id": "{{s8.job_id}}"
        }
      },
      {
        "id": "s10",
        "pack": "project",
        "kind": "write",
        "after": [
          "s9"
        ],
        "title": "Build the prototype",
        "write": {
          "tool": "build_prototype",
          "args": {
            "project_id": "{{s5.project_id}}",
            "title": "{{free}}"
          }
        },
        "produces": [
          "job_id"
        ]
      },
      {
        "id": "s11",
        "pack": "project",
        "kind": "wait",
        "after": [
          "s10"
        ],
        "title": "Wait for the prototype",
        "wait": {
          "for": "project_job",
          "project_id": "{{s5.project_id}}",
          "job_id": "{{s10.job_id}}",
          "timeout_minutes": 120
        }
      }
    ]
  },
  "valid": true,
  "errors": [],
  "needs_args_schema": false
}
