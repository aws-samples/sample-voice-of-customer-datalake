{
  "Comment": "The conductor walks an autonomous agent workflow or an approved assistant plan (agents/conductor).",
  "StartAt": "Start",
  "States": {
    "Advance": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RecordFailure",
          "ResultPath": "$.error"
        }
      ],
      "Next": "Route",
      "Parameters": {
        "FunctionName": "${ConductorFunctionArn}",
        "Payload": {
          "action": "advance",
          "agent_id.$": "$.agent_id",
          "node.$": "$.result.node",
          "run_id.$": "$.run_id"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.step",
      "ResultSelector": {
        "next.$": "$.Payload"
      },
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 4
        }
      ],
      "Type": "Task"
    },
    "Done": {
      "Type": "Succeed"
    },
    "ExecuteNode": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RecordFailure",
          "ResultPath": "$.error"
        }
      ],
      "Next": "Advance",
      "Parameters": {
        "FunctionName": "${NodesFunctionArn}",
        "Payload": {
          "action": "start",
          "agent_id.$": "$.agent_id",
          "mate_seq.$": "$.step.next.mate_seq",
          "node_id.$": "$.step.next.node_id",
          "run_id.$": "$.run_id"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.result",
      "ResultSelector": {
        "node.$": "$.Payload"
      },
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 4
        }
      ],
      "Type": "Task"
    },
    "Failed": {
      "Cause": "See the run event journal.",
      "Error": "AgentRunFailed",
      "Type": "Fail"
    },
    "Init": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RecordFailure",
          "ResultPath": "$.error"
        }
      ],
      "Next": "Route",
      "Parameters": {
        "FunctionName": "${ConductorFunctionArn}",
        "Payload": {
          "action": "init",
          "agent_id.$": "$.agent_id",
          "run_id.$": "$.run_id"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.step",
      "ResultSelector": {
        "next.$": "$.Payload"
      },
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 4
        }
      ],
      "Type": "Task"
    },
    "PersonaPanel": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RecordFailure",
          "ResultPath": "$.error"
        }
      ],
      "Next": "Advance",
      "Parameters": {
        "FunctionName": "${PersonaPanelFunctionArn}",
        "Payload": {
          "action": "start",
          "agent_id.$": "$.agent_id",
          "mate_seq.$": "$.step.next.mate_seq",
          "node_id.$": "$.step.next.node_id",
          "run_id.$": "$.run_id"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.result",
      "ResultSelector": {
        "node.$": "$.Payload"
      },
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 4
        }
      ],
      "Type": "Task"
    },
    "PlanDecide": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PlanRecordFailure",
          "ResultPath": "$.error"
        }
      ],
      "Next": "PlanRoute",
      "Parameters": {
        "FunctionName": "${ConductorFunctionArn}",
        "Payload": {
          "action": "plan_decide",
          "plan_id.$": "$.plan_id"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.plan",
      "ResultSelector": {
        "next.$": "$.Payload"
      },
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 4
        }
      ],
      "Type": "Task"
    },
    "PlanExecuteSteps": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PlanRecordFailure",
          "ResultPath": "$.error"
        }
      ],
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "PlanPrepare",
        "States": {
          "PlanPrepare": {
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "PlanStepError",
                "ResultPath": "$.error"
              }
            ],
            "Next": "PlanPrepared",
            "Parameters": {
              "FunctionName": "${ConductorFunctionArn}",
              "Payload": {
                "action": "plan_prepare",
                "plan_id.$": "$.plan_id",
                "step_id.$": "$.step_id"
              }
            },
            "Resource": "arn:aws:states:::lambda:invoke",
            "ResultPath": "$.prepare",
            "ResultSelector": {
              "prepared.$": "$.Payload"
            },
            "Retry": [
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "JitterStrategy": "FULL",
                "MaxAttempts": 4
              }
            ],
            "Type": "Task"
          },
          "PlanPrepared": {
            "Choices": [
              {
                "BooleanEquals": true,
                "Next": "PlanRunStep",
                "Variable": "$.prepare.prepared.run"
              }
            ],
            "Default": "PlanStepSkipped",
            "Type": "Choice"
          },
          "PlanRecord": {
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "PlanStepError",
                "ResultPath": "$.error"
              }
            ],
            "End": true,
            "Parameters": {
              "FunctionName": "${ConductorFunctionArn}",
              "Payload": {
                "action": "plan_record",
                "plan_id.$": "$.plan_id",
                "result.$": "$.result.step",
                "step_id.$": "$.step_id"
              }
            },
            "Resource": "arn:aws:states:::lambda:invoke",
            "ResultPath": "$.recorded",
            "ResultSelector": {
              "recorded.$": "$.Payload"
            },
            "Retry": [
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "JitterStrategy": "FULL",
                "MaxAttempts": 4
              }
            ],
            "Type": "Task"
          },
          "PlanRunStep": {
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "PlanStepError",
                "ResultPath": "$.error"
              }
            ],
            "Next": "PlanRecord",
            "Parameters": {
              "FunctionName": "${PlanStepFunctionArn}",
              "Payload.$": "$.prepare.prepared.event"
            },
            "Resource": "arn:aws:states:::lambda:invoke",
            "ResultPath": "$.result",
            "ResultSelector": {
              "step.$": "$.Payload"
            },
            "Retry": [
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "JitterStrategy": "FULL",
                "MaxAttempts": 4
              }
            ],
            "Type": "Task"
          },
          "PlanStepError": {
            "End": true,
            "Parameters": {
              "FunctionName": "${ConductorFunctionArn}",
              "Payload": {
                "action": "plan_record",
                "error.$": "$.error",
                "plan_id.$": "$.plan_id",
                "step_id.$": "$.step_id"
              }
            },
            "Resource": "arn:aws:states:::lambda:invoke",
            "ResultPath": "$.recorded",
            "ResultSelector": {
              "recorded.$": "$.Payload"
            },
            "Retry": [
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "JitterStrategy": "FULL",
                "MaxAttempts": 4
              }
            ],
            "Type": "Task"
          },
          "PlanStepSkipped": {
            "Type": "Succeed"
          }
        }
      },
      "ItemSelector": {
        "plan_id.$": "$.plan_id",
        "step_id.$": "$$.Map.Item.Value"
      },
      "ItemsPath": "$.plan.next.steps",
      "MaxConcurrency": 3,
      "Next": "PlanDecide",
      "ResultPath": null,
      "Type": "Map"
    },
    "PlanRecordFailure": {
      "Next": "Failed",
      "Parameters": {
        "FunctionName": "${ConductorFunctionArn}",
        "Payload": {
          "action": "plan_fail",
          "error.$": "$.error",
          "plan_id.$": "$.plan_id"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.plan",
      "ResultSelector": {
        "next.$": "$.Payload"
      },
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 4
        }
      ],
      "Type": "Task"
    },
    "PlanRoute": {
      "Choices": [
        {
          "Next": "PlanExecuteSteps",
          "StringEquals": "execute",
          "Variable": "$.plan.next.kind"
        },
        {
          "Next": "PlanWait",
          "StringEquals": "wait",
          "Variable": "$.plan.next.kind"
        }
      ],
      "Default": "Done",
      "Type": "Choice"
    },
    "PlanWait": {
      "Next": "PlanDecide",
      "SecondsPath": "$.plan.next.wait_seconds",
      "Type": "Wait"
    },
    "PollNode": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RecordFailure",
          "ResultPath": "$.error"
        }
      ],
      "Next": "Advance",
      "Parameters": {
        "FunctionName": "${NodesFunctionArn}",
        "Payload": {
          "action": "poll",
          "agent_id.$": "$.agent_id",
          "node_id.$": "$.step.next.node_id",
          "pending.$": "$.step.next.pending",
          "run_id.$": "$.run_id"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.result",
      "ResultSelector": {
        "node.$": "$.Payload"
      },
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 4
        }
      ],
      "Type": "Task"
    },
    "RecordFailure": {
      "Next": "Failed",
      "Parameters": {
        "FunctionName": "${ConductorFunctionArn}",
        "Payload": {
          "action": "fail",
          "agent_id.$": "$.agent_id",
          "error.$": "$.error",
          "run_id.$": "$.run_id"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.step",
      "ResultSelector": {
        "next.$": "$.Payload"
      },
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 4
        }
      ],
      "Type": "Task"
    },
    "Route": {
      "Choices": [
        {
          "And": [
            {
              "StringEquals": "execute",
              "Variable": "$.step.next.kind"
            },
            {
              "StringEquals": "persona_review",
              "Variable": "$.step.next.node_type"
            }
          ],
          "Next": "PersonaPanel"
        },
        {
          "Next": "ExecuteNode",
          "StringEquals": "execute",
          "Variable": "$.step.next.kind"
        },
        {
          "Next": "WaitForJob",
          "StringEquals": "wait",
          "Variable": "$.step.next.kind"
        }
      ],
      "Default": "Done",
      "Type": "Choice"
    },
    "Start": {
      "Choices": [
        {
          "And": [
            {
              "IsPresent": true,
              "Variable": "$.run_kind"
            },
            {
              "StringEquals": "plan",
              "Variable": "$.run_kind"
            }
          ],
          "Next": "PlanDecide"
        }
      ],
      "Default": "Init",
      "Type": "Choice"
    },
    "WaitForJob": {
      "Next": "PollNode",
      "SecondsPath": "$.step.next.wait_seconds",
      "Type": "Wait"
    }
  },
  "TimeoutSeconds": 86400
}
