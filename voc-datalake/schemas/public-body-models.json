{
  "FeedbackFormSubmission": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "FeedbackFormSubmission",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1
      },
      "answers": {
        "type": "object",
        "maxProperties": 30,
        "patternProperties": {
          "^q_[a-z0-9_]{1,40}$": {}
        },
        "additionalProperties": false
      },
      "hidden": {
        "type": [
          "object",
          "null"
        ],
        "maxProperties": 20,
        "patternProperties": {
          "^[a-z][a-z0-9_]{0,39}$": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "form_revision": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "language": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^(en|es|fr|de|pt|ja|zh|ko|pl)$"
      },
      "ending_id": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 44
      },
      "session": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[A-Za-z0-9_-]{8,64}$"
      },
      "channel": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^(link|iframe|script)$"
      },
      "form_id": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 64
      },
      "test": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 64
      },
      "rating": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 1,
        "maximum": 10
      },
      "name": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 200
      },
      "email": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 254
      },
      "page_url": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 4096
      },
      "custom_fields": {
        "type": [
          "object",
          "null"
        ],
        "maxProperties": 20,
        "patternProperties": {
          "^$": {
            "not": {}
          }
        },
        "additionalProperties": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "maxLength": 1000
        }
      },
      "dimensions": {
        "type": [
          "object",
          "null"
        ],
        "maxProperties": 10
      }
    }
  },
  "FeedbackFormEvent": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "FeedbackFormEvent",
    "type": "object",
    "required": [
      "event"
    ],
    "additionalProperties": false,
    "properties": {
      "event": {
        "type": "object",
        "required": [
          "kind",
          "session"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "left",
              "opened"
            ]
          },
          "question_id": {
            "type": "string",
            "pattern": "^q_[a-z0-9_]{1,40}$"
          },
          "session": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "test": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 64
      }
    }
  },
  "BallotSubmission": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "BallotSubmission",
    "type": "object",
    "properties": {
      "notes": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
