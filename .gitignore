# Dependencies
node_modules/

# Build output
dist/
*.d.ts
# ...but this one is hand-written SOURCE, not tsc output. It types the plain-JS
# custom-resource handler that core-stack.ts inlines (the handler cannot be
# TypeScript: inline Lambda code is never bundled). Without it tracked,
# `npm run typecheck:cdk` fails on a fresh clone.
!voc-datalake/lambda/custom_resources/*.d.ts

# CDK
cdk.out/
!eslint.config.js

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/

# Lambda layers (built artifacts)
voc-datalake/lambda/layers/*/python/
!voc-datalake/lambda/layers/*/python/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# AWS
.aws-sam/

# Test coverage
.coverage
coverage/
htmlcov/

# Secrets (never commit)
secrets.json
*.pem
*.key

# Temporary files
*.tmp
*.bak

.threat-composer
*.bak

# Workshop files
voc-datalake/Workshop/*

.tmp/

# Agent memory — local-only working context, NEVER commit.
# This repo is public and these notes contain AWS account ids, live CloudFront
# domains and details of not-yet-fixed issues. The sibling .kiro/ dirs
# (steering, agents, hooks, prompts, settings) ARE tracked on purpose, so a
# `git add .kiro/` would otherwise publish memory along with them.
.kiro/memory/
.kiro/sessions/
.kiro/NEW_SESSION_PROMPT.md
