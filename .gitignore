# Dependencies
node_modules/

# Build output
dist/
*.d.ts
# ...but this one is hand-written SOURCE, not tsc output. It types the plain-JS
# custom-resource handler in that directory so the CDK tests can import it with
# real types; without it tracked, `npm run typecheck:cdk` fails on a fresh clone.
# (The handler stays plain JS because nothing transpiles it — the function ships
# the directory as an asset. Moving it to TypeScript would mean a NodejsFunction
# with esbuild, which would retire this file and this negation.)
!voc-datalake/lambda/custom_resources/*.d.ts

# CDK
cdk.out/
!eslint.config.js

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/

# Lambda layers (built artifacts)
voc-datalake/lambda/layers/*/python/
!voc-datalake/lambda/layers/*/python/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# AWS
.aws-sam/

# Test coverage
.coverage
coverage/
htmlcov/

# JUnit report written by the MCP CI gate (see scripts/mcp_gate.py). Produced on
# any local run of that gate's pytest command too, so it is ignored rather than
# left to be committed by accident.
mcp-gate-report.xml

# Secrets (never commit)
secrets.json
*.pem
*.key

# Temporary files
*.tmp
*.bak

.threat-composer
*.bak

# Workshop files
voc-datalake/Workshop/*

.tmp/

# Agent memory — local-only working context, NEVER commit.
# This repo is public and these notes contain AWS account ids, live CloudFront
# domains and details of not-yet-fixed issues. The sibling .kiro/ dirs
# (steering, agents, hooks, prompts, settings) ARE tracked on purpose, so a
# `git add .kiro/` would otherwise publish memory along with them.
.kiro/memory/
.kiro/sessions/
.kiro/NEW_SESSION_PROMPT.md
# MCP client config — carries a live bearer token inline in headers.Authorization.
# .kiro/settings/ is otherwise tracked (context-rules.json), so without this line
# sharing an MCP config with the team publishes a working credential to a PUBLIC repo.
.kiro/settings/mcp.json
